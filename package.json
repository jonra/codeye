{
  "name": "codeye",
  "version": "0.4.0",
  "description": "Claude Code statusline HUD — context burn rate, cost tracking, git status, stall detection",
  "type": "module",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc",
    "build:bun": "bun build src/index.ts --outdir dist --target node --format esm",
    "typecheck": "tsc --noEmit",
    "test:mock":      "echo '{\"hook_event_name\":\"Status\",\"session_id\":\"test-123\",\"cwd\":\"/Users/jon/projects/bb1os\",\"model\":{\"id\":\"claude-opus-4-6\",\"display_name\":\"Opus 4.6\"},\"workspace\":{\"current_dir\":\"/Users/jon/projects/bb1os\"},\"context_window\":{\"used_percentage\":42,\"remaining_percentage\":58,\"current_usage\":{\"input_tokens\":84000,\"cache_creation_input_tokens\":12000,\"cache_read_input_tokens\":5000,\"output_tokens\":3200},\"context_window_size\":200000,\"total_input_tokens\":84000,\"total_output_tokens\":3200},\"cost\":{\"total_cost_usd\":0.24}}' | node dist/src/index.js",
    "test:critical":  "echo '{\"hook_event_name\":\"Status\",\"session_id\":\"test-456\",\"cwd\":\"/Users/jon/projects/atlas\",\"model\":{\"id\":\"claude-opus-4-6\",\"display_name\":\"Opus 4.6\"},\"workspace\":{\"current_dir\":\"/Users/jon/projects/atlas\"},\"context_window\":{\"used_percentage\":87,\"remaining_percentage\":13,\"current_usage\":{\"input_tokens\":174000,\"cache_creation_input_tokens\":8000,\"cache_read_input_tokens\":2000,\"output_tokens\":6400},\"context_window_size\":200000,\"total_input_tokens\":174000,\"total_output_tokens\":6400},\"cost\":{\"total_cost_usd\":1.82}}' | node dist/src/index.js",
    "test:fresh":     "echo '{\"hook_event_name\":\"Status\",\"session_id\":\"test-789\",\"cwd\":\"/Users/jon/projects/bb1os\",\"model\":{\"id\":\"claude-opus-4-6\",\"display_name\":\"Opus 4.6\"},\"workspace\":{\"current_dir\":\"/Users/jon/projects/bb1os\"},\"context_window\":{\"used_percentage\":0,\"remaining_percentage\":100,\"current_usage\":null,\"context_window_size\":200000,\"total_input_tokens\":0,\"total_output_tokens\":0},\"cost\":{\"total_cost_usd\":0}}' | node dist/src/index.js",
    "test:expensive": "echo '{\"hook_event_name\":\"Status\",\"session_id\":\"test-999\",\"cwd\":\"/Users/jon/projects/atlas-sentinel\",\"model\":{\"id\":\"claude-opus-4-6\",\"display_name\":\"Opus 4.6\"},\"workspace\":{\"current_dir\":\"/Users/jon/projects/atlas-sentinel\"},\"context_window\":{\"used_percentage\":61,\"remaining_percentage\":39,\"current_usage\":{\"input_tokens\":122000,\"cache_creation_input_tokens\":4000,\"cache_read_input_tokens\":2000,\"output_tokens\":8800},\"context_window_size\":200000,\"total_input_tokens\":122000,\"total_output_tokens\":8800},\"cost\":{\"total_cost_usd\":3.47}}' | node dist/src/index.js",
    "test:ratelimit": "echo '{\"hook_event_name\":\"Status\",\"session_id\":\"test-rl\",\"cwd\":\"/Users/jon/projects/bb1os\",\"model\":{\"id\":\"claude-opus-4-6\",\"display_name\":\"Opus 4.6\"},\"workspace\":{\"current_dir\":\"/Users/jon/projects/bb1os\"},\"context_window\":{\"used_percentage\":42,\"remaining_percentage\":58,\"current_usage\":{\"input_tokens\":84000,\"cache_creation_input_tokens\":12000,\"cache_read_input_tokens\":5000,\"output_tokens\":3200},\"context_window_size\":200000,\"total_input_tokens\":84000,\"total_output_tokens\":3200},\"cost\":{\"total_cost_usd\":0.24},\"rate_limits\":{\"five_hour\":{\"used_percentage\":73,\"resets_at\":1774224600},\"seven_day\":{\"used_percentage\":45,\"resets_at\":1774771200}}}' | node dist/src/index.js"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": ["claude-code", "statusline", "plugin", "hud", "terminal"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jonra/codeye"
  }
}
